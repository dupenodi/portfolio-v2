# Resend — contact form email delivery
# Get your API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email address that receives contact form submissions
CONTACT_EMAIL=you@example.com

# GitHub username for dynamic project fetching
# Tag repos with the "portfolio" topic to feature them
GITHUB_USERNAME=yourusername

# Optional: GitHub personal access token (increases rate limit)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# BearBlog Atom feed URL for blog posts
BLOG_FEED_URL=https://yourblog.bearblog.dev/feed/

# Raindrop.io — bookmarks
# Get your test token at https://app.raindrop.io/settings/integrations
RAINDROP_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Raindrop.io collection ID — use 0 for all bookmarks
RAINDROP_COLLECTION_ID=0
