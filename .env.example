# ── Supabase: all site content (experience, projects, writing, photos, link cards) ─
# Project settings → API keys. None of these are NEXT_PUBLIC_; they stay on the server.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...   # server only; used by /admin to write

# ── /admin sign-in ───────────────────────────────────────────────────────────
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=   # 32+ random characters: openssl rand -hex 32

# ── the phone chat in the studio ─────────────────────────────────────────────
# OPENROUTER_API_KEY=
