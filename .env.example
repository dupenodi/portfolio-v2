# ── Site ─────────────────────────────────────────────────────────────────────
# Public site URL (used by refresh script in production)
SITE_URL=https://dupenodi.dev

# Hero + OG: “available for opportunities” (default off). Set true to show.
# AVAILABLE_FOR_OPPORTUNITIES=true

# ── GitHub (projects on /projects and home) ───────────────────────────────────
GITHUB_USERNAME=dupenodi

# Optional: raises API rate limit; recommended for GitHub GraphQL (contributions on home).
# Use a classic PAT with `repo` scope to also pull private repos tagged `portfolio`.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# How long to cache GitHub API responses (seconds). Default 300 (~5 min).
GITHUB_REVALIDATE_SECONDS=300

# Refresh /projects after tagging repos on GitHub (use your GitHub PAT):
#   curl -X POST https://www.dupenodi.dev/api/projects/refresh \
#     -H "Authorization: Bearer ghp_xxxxxxxxxxxx"
# Note: dupenodi.dev redirects to www — do not use curl --location or the auth header is dropped.

# ── gtabid.lol booth webhook ─────────────────────────────────────────────────
# Paste this URL in Owner tools → Prefer a webhook? (use www, not the apex):
#   https://www.dupenodi.dev/api/gtabid/hook
#
# HMAC secret — generate with: openssl rand -hex 32
# Same value goes in gtabid's "Signing secret" field.
# GTABID_WEBHOOK_SECRET=
#
# LLM (one of these). Groq is fastest for the 20s booth budget.
# GROQ_API_KEY=
# OPENAI_API_KEY=
# Optional:
# GTABID_LLM_MODEL=openai/gpt-oss-20b
